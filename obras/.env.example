# Postgres para desarrollo local.
# Con `npm run db:up` se levanta este contenedor (ver docker-compose.yml).
DATABASE_URL="postgresql://obras:obras@localhost:5433/obras?schema=public"

# Firma única para v1 (el modelo ya lleva firm_id en todas las tablas).
DEFAULT_FIRM_ID="firm_default"

# ── Acceso ────────────────────────────────────────────────────
# La app entera está detrás de una contraseña compartida (sin usuarios
# ni roles). Generá los dos valores con:
#
#   npm run auth:hash -- "la contraseña que quieras"
#
# AUTH_PASSWORD_HASH guarda un hash scrypt, nunca la contraseña.
# SESSION_SECRET firma la cookie de sesión: si cambia, se cierran
# todas las sesiones abiertas.
# Sin estos dos valores la app queda INACCESIBLE (cierra ante la duda).
AUTH_PASSWORD_HASH=""
SESSION_SECRET=""
