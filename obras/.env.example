# Postgres para desarrollo local.
# Con `npm run db:up` se levanta este contenedor (ver docker-compose.yml).
DATABASE_URL="postgresql://obras:obras@localhost:5433/obras?schema=public"

# Firma única para v1 (el modelo ya lleva firm_id en todas las tablas).
DEFAULT_FIRM_ID="firm_default"

# ── Acceso ────────────────────────────────────────────────────
# La app entera está detrás de un login con cuentas nombradas (tabla
# User) — no hay alta pública. Sin SESSION_SECRET la app queda
# INACCESIBLE (cierra ante la duda).
#
# SESSION_SECRET firma la cookie de sesión: si cambia, se cierran todas
# las sesiones abiertas. Generá uno nuevo con:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Las cuentas se crean por CLI, una vez desplegado, apuntando
# DATABASE_URL a la base que corresponda:
#
#   npm run auth:create-user -- "Nombre" "usuario" "contraseña"
