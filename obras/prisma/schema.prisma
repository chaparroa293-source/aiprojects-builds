// Obras — esquema Prisma
// Slice 1: directorio (Clientes / Proveedores / Personal).
// Slice 2: Proyectos + árbol de Segmentos (sin dinero todavía).
// Slice 3: Gastos (captura rápida). Un gasto = un proyecto + un segmento.
// Pedidos, Notas y Adjuntos llegan en slices posteriores.
//
// Regla transversal: firm_id en TODAS las tablas desde el inicio
// (una sola firma en v1, sin UI para cambiar de firma todavía).
//
// Montos en guaraníes: enteros, sin decimales. Se guardan como BigInt
// y se exponen a la UI como number (rango seguro para montos de obra).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(cuid())
  firmId    String    @map("firm_id")
  name      String
  phone     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projects  Project[]

  @@index([firmId])
  @@map("clients")
}

model Supplier {
  id        String    @id @default(cuid())
  firmId    String    @map("firm_id")
  name      String
  phone     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  expenses  Expense[]

  @@index([firmId])
  @@map("suppliers")
}

model Employee {
  id        String    @id @default(cuid())
  firmId    String    @map("firm_id")
  name      String
  phone     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([firmId])
  @@map("employees")
}

enum ProjectStatus {
  ACTIVE
  FINISHED
}

model Project {
  id               String        @id @default(cuid())
  firmId           String        @map("firm_id")
  name             String
  // Cliente opcional: se puede armar un proyecto antes de tener el
  // cliente cargado en el directorio, o dejarlo sin asignar.
  clientId         String?       @map("client_id")
  // Precio total acordado, en guaraníes (entero). El valor vigente es
  // siempre el último; el historial vive en PriceRevision.
  agreedTotalPrice BigInt        @map("agreed_total_price")
  // "Terminado" es un toggle manual, nunca calculado por gasto ni fecha.
  status           ProjectStatus @default(ACTIVE)
  // Archivar: saca al proyecto de la lista activa sin destruir sus
  // registros. Es la salida para proyectos con historial financiero
  // que ya no se pueden borrar en duro (ver deleteProject).
  archivedAt       DateTime?     @map("archived_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  segments       Segment[]
  priceRevisions PriceRevision[]
  expenses       Expense[]

  @@index([firmId])
  @@index([clientId])
  @@map("projects")
}

model PriceRevision {
  id        String   @id @default(cuid())
  firmId    String   @map("firm_id")
  projectId String   @map("project_id")
  oldValue  BigInt   @map("old_value")
  newValue  BigInt   @map("new_value")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([projectId])
  @@map("price_revisions")
}

model Segment {
  id        String   @id @default(cuid())
  firmId    String   @map("firm_id")
  projectId String   @map("project_id")
  // Árbol recursivo de profundidad arbitraria. null = segmento raíz.
  parentId  String?  @map("parent_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict: no se puede borrar un segmento que todavía tiene hijos
  // o gastos (regla de bloqueo de la spec, decisión #2). La app además
  // valida esto antes para dar un mensaje claro en español.
  parent   Segment?  @relation("SegmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Segment[] @relation("SegmentTree")
  expenses Expense[]

  @@index([firmId])
  @@index([projectId])
  @@index([parentId])
  @@map("segments")
}

model Expense {
  id          String   @id @default(cuid())
  firmId      String   @map("firm_id")
  // Un gasto pertenece siempre a EXACTAMENTE un proyecto y un segmento
  // (sin gastos "sin segmentar", sin gastos repartidos entre proyectos).
  projectId   String   @map("project_id")
  segmentId   String   @map("segment_id")
  // Proveedor opcional.
  supplierId  String?  @map("supplier_id")
  // Monto en guaraníes, entero.
  amount      BigInt
  description String?
  // Fecha en que se hizo el gasto (puede diferir de cuándo se cargó).
  spentAt     DateTime @default(now()) @map("spent_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Restrict a propósito (NO Cascade): un gasto es un registro
  // financiero. Borrar el proyecto o el segmento que lo contiene se
  // bloquea mientras exista el gasto — nunca se pierde en silencio.
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  segment  Segment  @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  // Borrar un proveedor del directorio NO borra el gasto: solo se
  // desvincula (spec, sección 1).
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([firmId])
  @@index([projectId])
  @@index([segmentId])
  @@index([supplierId])
  @@map("expenses")
}
